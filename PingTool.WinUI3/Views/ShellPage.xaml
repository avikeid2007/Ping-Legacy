<Page
    x:Class="PingTool.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:PingTool.Helpers"
    xmlns:models="using:PingTool.Models"
    xmlns:views="using:PingTool.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Invoked="OpenCommandPalette_Invoked" Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <NavigationView
            x:Name="navigationView"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="{x:Bind IsBackEnabled, Mode=OneWay}"
            IsSettingsVisible="True"
            ItemInvoked="OnItemInvoked"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind Selected, Mode=OneWay}">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Ping" helpers:NavHelper.NavigateTo="views:MainPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE968;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Multi-Ping" helpers:NavHelper.NavigateTo="views:MultiPingPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF0E2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Traceroute" helpers:NavHelper.NavigateTo="views:TraceroutePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Port Scanner" helpers:NavHelper.NavigateTo="views:PortScannerPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network Scanner" helpers:NavHelper.NavigateTo="views:NetworkScannerPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE839;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Subnet Calculator" helpers:NavHelper.NavigateTo="views:SubnetCalculatorPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8EF;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Speed Test" helpers:NavHelper.NavigateTo="views:SpeedTestPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B0;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scheduled" helpers:NavHelper.NavigateTo="views:ScheduledPingsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE823;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Data Usage" helpers:NavHelper.NavigateTo="views:DataUsagePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" helpers:NavHelper.NavigateTo="views:HistoryPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Feedback" helpers:NavHelper.NavigateTo="views:SuggestionPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE939;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="0,0,0,8">
                    <NavigationViewItem Content="Search (Ctrl+K)" Icon="Find" Tapped="SearchNavItem_Tapped" />
                    <NavigationViewItem Content="Rate Us" Icon="Like" Tapped="RateUs_Tapped"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <NavigationView.PaneHeader>
                <Border Padding="12,8" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image 
                            Width="36" Height="36" 
                            Source="ms-appx:///Assets/Logo.png" 
                            Stretch="UniformToFill"/>
                        <TextBlock 
                            Text="Ping Legacy" 
                            FontWeight="Bold" 
                            FontSize="16"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </NavigationView.PaneHeader>

            <Grid>
                <Frame x:Name="shellFrame" />
            </Grid>
        </NavigationView>

        <!-- Global Command Palette (Ctrl+K) -->
        <Grid
            x:Name="CommandPaletteOverlay"
            Background="#80000000"
            Tapped="CommandPaletteOverlay_Tapped"
            Visibility="Collapsed">
            <Border
                Width="560"
                MaxHeight="420"
                Margin="0,120,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Tapped="CommandPalettePanel_Tapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="CommandPaletteSearchBox"
                        Margin="12"
                        BorderThickness="0"
                        FontSize="16"
                        KeyDown="CommandPaletteSearchBox_KeyDown"
                        PlaceholderText="Search pages... (Esc to close)"
                        TextChanged="CommandPaletteSearchBox_TextChanged" />

                    <ListView
                        x:Name="CommandPaletteResultsList"
                        Grid.Row="1"
                        MaxHeight="320"
                        Margin="4,0,4,8"
                        IsItemClickEnabled="True"
                        ItemClick="CommandPaletteResultsList_ItemClick"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CommandPaletteItem">
                                <StackPanel Padding="8,6" Orientation="Horizontal" Spacing="12">
                                    <FontIcon
                                        Width="20"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel>
                                        <TextBlock FontSize="13" Text="{x:Bind Title}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Subtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
