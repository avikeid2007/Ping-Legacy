<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PingTool.Views.SubnetCalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="20">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="44"
                    Height="44"
                    Background="{StaticResource AccentGradientBrush}"
                    CornerRadius="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="White"
                        Glyph="&#xE8EF;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Text="Subnet Calculator" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Calculate network, broadcast, and usable host range from CIDR notation" />
                </StackPanel>
            </StackPanel>

            <!-- Input -->
            <Border Style="{StaticResource ModernCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="CIDR Address" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="400" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            KeyDown="Input_KeyDown"
                            PlaceholderText="192.168.1.10/24"
                            Text="{x:Bind ViewModel.Input, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="16,8"
                            Command="{x:Bind ViewModel.CalculateCommand}"
                            Content="Calculate"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind GetErrorVisibility(ViewModel.ErrorMessage), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border
                Style="{StaticResource ModernCardStyle}"
                Visibility="{x:Bind GetResultVisibility(ViewModel.Result), Mode=OneWay}">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Results" />

                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Network Address" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.NetworkAddress, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Broadcast Address" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.BroadcastAddress, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Subnet Mask" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.SubnetMask, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Wildcard Mask" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.WildcardMask, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="First Usable Host" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.FirstUsableHost, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Last Usable Host" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.LastUsableHost, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total Addresses" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.TotalAddresses, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Usable Hosts" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.UsableHosts, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CIDR Notation" />
                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.CidrNotation, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="IP Class" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Result.IpClass, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Address Type" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind GetAddressType(ViewModel.Result.IsPrivate), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
