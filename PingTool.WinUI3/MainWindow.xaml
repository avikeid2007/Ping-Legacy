<Window
    x:Class="PingTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PingTool"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:views="using:PingTool.Views"
    Title="Ping Legacy">

    <Grid>
        <views:ShellPage x:Name="ShellFrame" />

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ContextMenuMode="PopupMenu"
            ToolTipText="Ping Legacy - idle">
            <!--
                IconSource is set in code-behind (see MainWindow.xaml.cs), not here: assigning an
                ImageSource straight from XAML (e.g. a BitmapImage loaded from ms-appx) decodes
                asynchronously, and H.NotifyIcon's native HICON conversion can run before the pixels
                are ready, throwing "Argument 'picture' must be a picture that can be used as a
                Icon." Loading/resizing synchronously via System.Drawing avoids that race.
            -->
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="ShowWindow_Click" Text="Show Ping Legacy">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE740;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="ExitApp_Click" Text="Exit">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
